<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SAMBEAUTIES — Avis & Réseaux</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 24px 16px;
      font-family: 'Montserrat', sans-serif;
      /* Remplace l'URL ci-dessous par ta photo de fond (ex: url('bg.jpg')) */
      background-image: linear-gradient(rgba(30, 24, 19, 0.25), rgba(30, 24, 19, 0.35)),
                        url('https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=1000&q=80');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
    }

    .card {
      width: 100%;
      max-width: 390px;
      background: rgba(232, 219, 203, 0.88);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-radius: 28px;
      padding: 0 24px 28px 24px;
      margin-top: 56px;
      box-shadow: 0 18px 40px rgba(0, 0, 0, 0.22);
      text-align: center;
      opacity: 0;
      transform: translateY(22px);
      animation: fadeUp 0.75s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    .logo-wrap {
      width: 112px;
      height: 112px;
      margin: -56px auto 18px auto;
      border-radius: 50%;
      background: #2b211b;
      border: 3px solid rgba(255, 250, 244, 0.85);
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      color: #f6efe6;
      box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
      overflow: hidden;
      opacity: 0;
      transform: scale(0.92);
      animation: popIn 0.65s ease 0.15s forwards;
    }

    /* Si tu utilises une image logo.png, décommente/utilise <img src="logo.png" ...> dans le HTML */
    .logo-wrap img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .logo-title {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 1.5px;
      line-height: 1.3;
      padding: 0 6px;
    }

    .logo-sub {
      font-size: 7.5px;
      letter-spacing: 2px;
      opacity: 0.8;
      margin-top: 2px;
    }

    h1 {
      font-family: 'Cinzel', serif;
      font-size: 21px;
      font-weight: 500;
      letter-spacing: 1.5px;
      color: #2c241e;
      margin-bottom: 24px;
      opacity: 0;
      transform: translateY(12px);
      animation: fadeUp 0.6s ease 0.25s forwards;
    }

    .links {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .btn {
      display: flex;
      align-items: center;
      justify-content: center;
      text-decoration: none;
      background: rgba(252, 249, 245, 0.94);
      color: #2c241e;
      border: 1px solid rgba(92, 74, 58, 0.22);
      border-radius: 14px;
      padding: 15px 18px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      box-shadow: 0 4px 12px rgba(44, 36, 30, 0.08);
      transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
      opacity: 0;
      transform: translateY(14px);
    }

    .btn:nth-child(1) { animation: fadeUp 0.55s ease 0.35s forwards, softPulse 2.8s ease-in-out 1.4s infinite; }
    .btn:nth-child(2) { animation: fadeUp 0.55s ease 0.45s forwards; }
    .btn:nth-child(3) { animation: fadeUp 0.55s ease 0.55s forwards; }
    .btn:nth-child(4) { animation: fadeUp 0.55s ease 0.65s forwards; }

    .btn:hover {
      transform: translateY(-2px);
      background: #ffffff;
      box-shadow: 0 8px 18px rgba(44, 36, 30, 0.14);
    }

    .btn:active {
      transform: scale(0.98);
    }

    .socials {
      margin-top: 26px;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 22px;
      opacity: 0;
      animation: fadeUp 0.6s ease 0.75s forwards;
    }

    .socials a {
      color: #ffffff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.45));
      transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .socials a:hover {
      transform: translateY(-2px) scale(1.08);
      opacity: 0.9;
    }

    .socials svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    @keyframes fadeUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes popIn {
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes softPulse {
      0%, 100% {
        box-shadow: 0 4px 12px rgba(44, 36, 30, 0.08);
      }
      50% {
        box-shadow: 0 6px 20px rgba(44, 36, 30, 0.22);
      }
    }
  </style>
</head>
<body>
  <main class="card">
    <div class="logo-wrap">
      <!-- Pour utiliser une image à la place du texte, remplace les lignes ci-dessous par : <img src="logo.png" alt="Logo"> -->
      <span class="logo-title">SAMBEAUTIES</span>
      <span class="logo-sub">RÉPUBLIQUE</span>
    </div>

    <h1>AVIS &amp; RÉSEAUX</h1>

    <nav class="links">
      <!-- Remplace les "#" par les vrais liens du commerce -->
      <a class="btn" href="#avis-google" target="_blank" rel="noopener">LAISSEZ NOUS UN AVIS</a>
      <a class="btn" href="#boutique" target="_blank" rel="noopener">BOUTIQUE</a>
      <a class="btn" href="#instagram" target="_blank" rel="noopener">INSTAGRAM</a>
      <a class="btn" href="#tiktok" target="_blank" rel="noopener">TIKTOK</a>
    </nav>

    <div class="socials" aria-label="Réseaux sociaux">
      <!-- TikTok -->
      <a href="#tiktok" target="_blank" rel="noopener" aria-label="TikTok">
        <svg viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/></svg>
      </a>
      <!-- Instagram -->
      <a href="#instagram" target="_blank" rel="noopener" aria-label="Instagram">
        <svg viewBox="0 0 24 24"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/></svg>
      </a>
      <!-- Facebook -->
      <a href="#facebook" target="_blank" rel="noopener" aria-label="Facebook">
        <svg viewBox="0 0 24 24"><path d="M12 2.04c-5.5 0-10 4.49-10 10.02 0 5 3.66 9.15 8.44 9.9v-7H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.9h-2.33v7a10 10 0 0 0 8.44-9.9c0-5.53-4.5-10.02-10-10.02z"/></svg>
      </a>
      <!-- Snapchat -->
      <a href="#snapchat" target="_blank" rel="noopener" aria-label="Snapchat">
        <svg viewBox="0 0 24 24"><path d="M12.2 2c2.4 0 4.5 1.4 4.8 4.2.1 1.1-.1 2.2-.2 2.7.3.2.8.2 1.2.1.4-.1.8-.2 1.1.1.3.3.3.8 0 1.2-.4.5-1.2.8-1.8 1.1.3 1.5 1.3 3.1 2.8 3.8.3.1.5.4.4.8-.1.4-.5.6-1 .7-.6.1-1.3.2-1.8.6-.4.3-.6.9-1 1.2-.5.4-1.2.3-1.8.1-.7-.2-1.4-.4-2.1-.4s-1.4.2-2.1.4c-.6.2-1.3.3-1.8-.1-.4-.3-.6-.9-1-1.2-.5-.4-1.2-.5-1.8-.6-.5-.1-.9-.3-1-.7-.1-.4.1-.7.4-.8 1.5-.7 2.5-2.3 2.8-3.8-.6-.3-1.4-.6-1.8-1.1-.3-.4-.3-.9 0-1.2.3-.3.7-.2 1.1-.1.4.1.9.1 1.2-.1-.1-.5-.3-1.6-.2-2.7C7.7 3.4 9.8 2 12.2 2z"/></svg>
      </a>
    </div>
  </main>
</body>
</html>
